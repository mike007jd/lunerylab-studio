<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		ComfyUI attach: user-configured ComfyUI servers serve their web canvas
		over plain http on LAN / Tailscale addresses. NSAllowsArbitraryLoadsInWebContent
		lifts ATS for WebView content loads ONLY — native URLSession/Node traffic
		keeps full ATS. Tauri merges this file into the generated bundle Info.plist.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
